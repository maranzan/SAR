<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="specs/|implem/|given/|given/tests/|given/api/|given/utils/|imlem2/" kind="src" path=""/>
	<classpathentry kind="src" path="imlem2"/>
	<classpathentry kind="src" path="given/tests"/>
	<classpathentry kind="src" path="given/api"/>
	<classpathentry kind="src" path="given/utils"/>
	<classpathentry excluding="tests/|api/|utils/" kind="src" path="given"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
